# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Fine-grained GitHub Personal Access Token (used by Steps 1-3 CLI scripts
# and for one-click web sign-in when GitHub OAuth is not configured).
# Recommended scopes: Pull requests (Read-only), Contents (Read-only), Metadata (Read-only)
GITHUB_TOKEN=

# Optional: GitHub OAuth App credentials for multi-user OAuth + PKCE sign-in.
# Callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local server bind settings (loopback only)
HOST=127.0.0.1
PORT=3000

# Model powering the Managed Agent harness (antigravity-preview-09-2026)
GEMINI_AGENT_MODEL=gemini-3.8-flash

# Optional: 32+ character secret to persist local sessions across server restarts
# SESSION_SECRET=
