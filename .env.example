# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GitHub OAuth App credentials (https://github.com/settings/developers -> OAuth Apps)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local server bind settings (loopback only)
HOST=127.0.0.1
PORT=3000

# Model powering the Managed Agent harness (antigravity-preview-09-2026)
GEMINI_AGENT_MODEL=gemini-4-carbon

# Optional: 32+ character secret to persist local sessions across server restarts
# SESSION_SECRET=
